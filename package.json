{
  "name": "mostly-harmless-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && vite build --ssr src/prerender.tsx --outDir .prerender && node scripts/prerender.mjs && node scripts/validate.mjs && node scripts/performance-budget.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit && node scripts/validate.mjs"
  },
  "dependencies": {
    "@tweenjs/tween.js": "^25.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
